{
  "name": "unespacio-plataforma-web",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Unespacio Citas: agenda unificada y automatizaciones opcionales con correo",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/booking.test.mjs tests/server-domain.test.mjs tests/server-auth.test.mjs",
    "check": "npm run typecheck && npm test",
    "dev:build": "node scripts/build.mjs --development",
    "dev": "npm run dev:build && node scripts/serve.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "api": "node server/app.mjs",
    "db:migrate": "node server/db.mjs",
    "test:server": "node --test tests/server-domain.test.mjs tests/server-auth.test.mjs",
    "test:integration": "node --test tests/server-integration.test.mjs",
    "worker": "node server/worker.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "luxon": "^3.7.2",
    "nodemailer": "^7.0.10"
  }
}
